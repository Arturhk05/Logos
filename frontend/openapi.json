          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionedRequest": {
        "description": "Every change to an incident carries the version the user saw, so concurrent changes are detected (ADR-02).",
        "properties": {
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version"
        ],
        "title": "VersionedRequest",
        "type": "object"
      }
